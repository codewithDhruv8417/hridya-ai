# ---------------------------------------------------------------------------
# Copy this file to backend/.env and fill in your own values.
# Nothing here is secret by default; never commit a real .env.
# ---------------------------------------------------------------------------

APP_NAME="HRIDYA AI Backend"
ENVIRONMENT=development
DEBUG=true

# Comma separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- Database ---------------------------------------------------------------
# MySQL is the intended database. DATABASE_URL wins over the DB_* fields.
# DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/mental_health_db
#
# Set AUTO_INIT_DB=false once you manage the schema with migrations.
AUTO_INIT_DB=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mental_health_db

# --- Auth -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-before-you-deploy
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Model files ------------------------------------------------------------
MODEL_PATH=ml_models/hridya_screening_model.joblib
FEATURE_SCHEMA_PATH=ml_models/feature_schema.json
ENCODER_BUNDLE_PATH=ml_models/hridya_encoders.joblib
MODEL_NAME=Hridya-Screening
MODEL_VERSION=v1.2.0
MODEL_ACCURACY=91.95

# --- Gemini (chat) ----------------------------------------------------------
# Get a key from Google AI Studio. Leave empty to use the built-in safe fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- MedGemma (risk explanations) -------------------------------------------
# Point at your own inference server, e.g. a local TGI container:
# MEDGEMMA_ENDPOINT=http://127.0.0.1:8080/generate
# Leave empty to use the deterministic local explainer.
MEDGEMMA_ENDPOINT=
